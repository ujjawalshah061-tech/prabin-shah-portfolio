# Copy this file to ".env" and fill it in. NEVER commit .env.

# The Gmail account that SENDS the emails
GMAIL_USER=prabinshah919@gmail.com

# 16-character Gmail "App password"
# (Google Account > Security > 2-Step Verification > App passwords).
# Spaces are fine, e.g. abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=

# Where the inquiries are delivered (defaults to GMAIL_USER)
ADMIN_EMAIL=prabinshah919@gmail.com

# Name shown on the confirmation email to the visitor
OWNER_NAME=Prabin Shah

# API port (the Vite dev server proxies /api to this)
PORT=5050

# ---- CMS (Sanity) ----
# Project ID from sanity.io/manage (a short code like abc12xyz). Safe to be public.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
# Only for the one-time "npm run seed" (Sanity > API > Tokens > Editor). Keep private, never put in Vercel/Git.
SANITY_WRITE_TOKEN=
